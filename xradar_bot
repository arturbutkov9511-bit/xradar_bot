@bot.message_handler(commands=['top'])
def send_top(message):
    bot.send_message(message.chat.id, "🔍 Ищу новые монеты...")
    try:
        # Берём данные с DexScreener по сети Solana
        url = "https://api.dexscreener.com/latest/dex/search?q=solana"
        response = requests.get(url)
        data = response.json()

        if data['pairs']:
            text = "🔥 Топ 5 самых новых монет (по дате создания):\n\n"
            count = 0
            for pair in data['pairs']:
                if count < 5:
                    name = pair.get('baseToken', {}).get('name', 'Неизвестно')
                    link = pair.get('url', '#')
                    # Выводим название и ссылку
                    text += f"• {name}\n  [Смотреть на DexScreener]({link})\n\n"
                    count += 1
                else:
                    break
            bot.send_message(message.chat.id, text, parse_mode='Markdown', disable_web_page_preview=True)
        else:
            bot.send_message(message.chat.id, "Ничего не найдено.")
    except Exception as e:
        bot.send_message(message.chat.id, f"Произошла ошибка: {e}")

import os
from flask import Flask
import threading

app = Flask(__name__)

@app.route('/')
def home():
    return "Я живой! Бот работает."

def run_bot():
    print("Бот запущен в потоке!")
    bot.polling()

if __name__ == "__main__":
    # Запускаем бота в отдельном потоке
    bot_thread = threading.Thread(target=run_bot)
    bot_thread.start()
    # Запускаем веб-сервер, который нужен Render
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port)

